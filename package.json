{
  "name": "@mrzr/react-form-builder",
  "version": "0.1.0",
  "description": "Build a React form from a config, with react-hook-form: fields that show, hide, disable and fill each other, and your own components for the look.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohammadreza-zr/react-form-builder.git"
  },
  "homepage": "https://github.com/mohammadreza-zr/react-form-builder#readme",
  "bugs": {
    "url": "https://github.com/mohammadreza-zr/react-form-builder/issues"
  },
  "keywords": [
    "react",
    "react-hook-form",
    "form",
    "form-builder",
    "headless",
    "adapter",
    "jalali",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plain": {
      "types": "./dist/plain/index.d.ts",
      "default": "./dist/plain/index.js"
    },
    "./jalali": {
      "types": "./dist/jalali/index.d.ts",
      "default": "./dist/jalali/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "npm run build && vitest run",
    "docs:sync": "bash scripts/sync-wiki.sh",
    "prepublishOnly": "npm test"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-hook-form": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^30.1.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.60.0",
    "typescript": "~6.0.2",
    "vitest": "^4.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
